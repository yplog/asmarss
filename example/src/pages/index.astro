---
import FediFeed from "astro-fedifeed";
import "../styles.css";

const classList = {
  feed__list: "feed__list",
  feed__header: "feed__header",
  feed__avatar: "feed__avatar",
  feed__title: "feed__title",
  feed__description: "feed__description",
  post: "post",
  post__header: "post__header",
  post__content: "post__content",
  post__media: "post__media",
  post__tags: "post__tags",
  post__footer: "post__footer",
  post__author: "post__author",
  post__author__avatar: "post__author__avatar",
  post__author__name: "post__author__name",
  post__title: "post__title",
  post__thumbnail: "post__thumbnail",
};
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>astro-fedifeed example</title>
  </head>
  <body>
    <h1>astro-fedifeed</h1>
    <p>
      Mastodon, Pixelfed and PeerTube posts as an Astro component. Live data
      from mastodon.social, pixelfed.social and video.blender.org.
    </p>

    <section class="platforms">
      <div class="platform">
        <h2>Mastodon</h2>
        <pre>&lt;FediFeed
  account="@Mastodon@mastodon.social"
  header tags limit=&#123;1&#125; /&gt;</pre>
        <FediFeed
          account="@Mastodon@mastodon.social"
          header
          tags
          limit={1}
          classList={classList}
        />
      </div>

      <div class="platform">
        <h2>Pixelfed</h2>
        <pre>&lt;FediFeed platform="pixelfed"
  account="@dansup@pixelfed.social"
  header tags limit=&#123;1&#125; /&gt;</pre>
        <FediFeed
          platform="pixelfed"
          account="@dansup@pixelfed.social"
          header
          tags
          limit={1}
          classList={classList}
        />
      </div>

      <div class="platform">
        <h2>PeerTube</h2>
        <pre>&lt;FediFeed
  channel="@blender_studio@video.blender.org"
  header limit=&#123;1&#125; /&gt;</pre>
        <FediFeed
          channel="@blender_studio@video.blender.org"
          header
          limit={1}
          classList={classList}
        />
      </div>
    </section>

    <section class="demo">
      <h2>Filtered by tag, with media only (Mastodon)</h2>
      <pre>&lt;FediFeed account="@Mastodon@mastodon.social" tag="Plushtodon" onlyWithMedia limit=&#123;2&#125; /&gt;</pre>
      <FediFeed
        account="@Mastodon@mastodon.social"
        tag="Plushtodon"
        onlyWithMedia
        limit={2}
        classList={classList}
      />
    </section>

    <section class="demo">
      <h2>Several accounts, merged</h2>
      <pre>&lt;FediFeed account=&#123;["@Mastodon@mastodon.social", "@Gargron@mastodon.social"]&#125; limit=&#123;4&#125; /&gt;</pre>
      <FediFeed
        account={["@Mastodon@mastodon.social", "@Gargron@mastodon.social"]}
        limit={4}
        classList={classList}
      />
    </section>
  </body>
</html>
