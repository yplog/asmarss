---
import FeedItem from "./components/FeedItem.astro";
import ErrorLoadingFeed from "./components/ErrorLoadingFeed.astro";
import NoItemsInFeed from "./components/NoItemsInFeed.astro";
import FeedHeader from "./components/FeedHeader.astro";
import {
  parseFeed,
  parseFeeds,
  reportError,
  reportWarning,
} from "./lib/parseFeed";
import { matchesFilter } from "./lib/filter";
import {
  mastodonFeedUrl,
  peertubeFeedUrl,
  pixelfedFeedUrl,
} from "./lib/feedUrl";
import { resolveClassList } from "./lib/classList";
import { defaultLabels } from "./lib/labels";
import {
  detectPlatform,
  mastodonOnlyOptions,
  normalizeEntry,
  platforms,
  type Platform,
} from "./lib/platforms";
import type { ClassList, Labels, ParsedFeed } from "./types";

type Source =
  | {
      /** RSS or Atom URL, e.g. `https://mastodon.social/@user.rss`. Pass an array to merge several feeds. */
      url: string | string[];
      account?: never;
      channel?: never;
      instance?: never;
      username?: never;
    }
  | {
      /** Full account name, e.g. `@user@mastodon.social`. Pass an array to merge several accounts. */
      account: string | string[];
      url?: never;
      channel?: never;
      instance?: never;
      username?: never;
    }
  | {
      /** PeerTube video channel, e.g. `@blender_studio@video.blender.org`. Implies `platform="peertube"`. */
      channel: string | string[];
      url?: never;
      account?: never;
      instance?: never;
      username?: never;
    }
  | {
      /** Instance host, e.g. `mastodon.social`. Use together with `username`. */
      instance: string;
      /** Account name on the instance, e.g. `user`. */
      username: string;
      url?: never;
      account?: never;
      channel?: never;
    };

interface Options {
  /** Where the account lives. Defaults to `"mastodon"`, or is guessed from `url`. */
  platform?: Platform;
  classList?: ClassList;
  limit?: number;
  separator?: boolean;
  /** @deprecated Misspelled, use `separator` instead. */
  seperator?: boolean;
  /** Render attached images, videos and audio. Defaults to `true`. */
  media?: boolean;
  /** Play videos in the page through the feed's player (PeerTube). Defaults to `false`. */
  embed?: boolean;
  /** Render a hashtag list for each post. Defaults to `false`. */
  tags?: boolean;
  /** Override the built-in (English) texts. */
  labels?: Labels;
  /** BCP 47 locale used to format dates, e.g. `tr-TR`. */
  locale?: string;
  /** IANA time zone used to format dates, e.g. `Europe/Istanbul`. */
  timeZone?: string;
  /** Render the feed title, description and avatar. Defaults to `false`. */
  header?: boolean;
  /** Only show posts with attachments. */
  onlyWithMedia?: boolean;
  /** Only show posts with this hashtag. */
  tag?: string;
  /** Include replies (account sources only; ignored when `tag` is set). */
  replies?: boolean;
  /** Strip unsafe markup from post content. Defaults to `true`. */
  sanitize?: boolean;
  /** Cache the parsed feed in memory for this many seconds. Defaults to 0 (off). */
  cacheTtl?: number;
  /** Retry network errors, 5xx and 429 this many times. Defaults to 0. */
  retries?: number;
  /** Request timeout in milliseconds. Defaults to 10000. */
  timeout?: number;
  /** Called when the feed fails to load; replaces the default `console.warn`. */
  onError?: (error: unknown, url: string) => void;
}

type Props = Source & Options;

const {
  url: urlProp,
  account,
  channel,
  instance,
  username,
  platform,
  classList: classListProp = {},
  limit,
  separator,
  seperator,
  media = true,
  embed = false,
  tags = false,
  labels,
  locale,
  timeZone,
  header = false,
  onlyWithMedia = false,
  tag,
  replies = false,
  sanitize = true,
  cacheTtl,
  retries,
  timeout,
  onError,
}: Props = Astro.props;
const classList = resolveClassList(classListProp);
const showSeparator = separator ?? seperator ?? false;
const l = { ...defaultLabels, ...labels };

const toList = (value: string | string[] | undefined) =>
  value === undefined ? [] : Array.isArray(value) ? value : [value];

let platformProp = platform;
if (platformProp !== undefined && !platforms.includes(platformProp)) {
  reportWarning(`Unknown platform "${platformProp}"`, "", onError);
  platformProp = undefined;
}
if (channel !== undefined && platformProp && platformProp !== "peertube") {
  reportWarning(
    "`channel` only works with PeerTube; using PeerTube",
    "",
    onError,
  );
}
const handlePlatform: Platform =
  channel !== undefined ? "peertube" : (platformProp ?? "mastodon");

const feedUrlOptions = { tag, onlyMedia: onlyWithMedia, replies };
const peertubeOptions = { channel: channel !== undefined };
function buildUrl(first: string, second?: string): string | null {
  switch (handlePlatform) {
    case "pixelfed":
      return pixelfedFeedUrl(first, second);
    case "peertube":
      return second === undefined
        ? peertubeFeedUrl(first, peertubeOptions)
        : peertubeFeedUrl(first, second, peertubeOptions);
    default:
      return second === undefined
        ? mastodonFeedUrl(first, feedUrlOptions)
        : mastodonFeedUrl(first, second, feedUrlOptions);
  }
}

// url > account > channel > instance + username
type ResolvedSource = {
  given: string;
  url: string | null;
  platform: Platform;
};
const handles = account ?? channel;
const sources: ResolvedSource[] =
  urlProp !== undefined
    ? toList(urlProp).map((u) => ({
        given: u,
        url: u || null,
        platform: platformProp ?? detectPlatform(u),
      }))
    : handles !== undefined
      ? toList(handles).map((h) => ({
          given: h,
          url: buildUrl(h),
          platform: handlePlatform,
        }))
      : instance !== undefined && username !== undefined
        ? [
            {
              given: `${instance} ${username}`,
              url: buildUrl(instance, username),
              platform: handlePlatform,
            },
          ]
        : [];

const usedMastodonOnly = mastodonOnlyOptions.filter(
  (name) => ({ tag, replies, onlyWithMedia })[name],
);
const urls: string[] = [];
const platformByUrl = new Map<string, Platform>();
for (const source of sources) {
  if (!source.url) {
    reportError(
      new Error("Invalid or missing feed source"),
      source.given.trim(),
      onError,
    );
    continue;
  }
  urls.push(source.url);
  platformByUrl.set(source.url, source.platform);
  if (source.platform !== "mastodon" && usedMastodonOnly.length > 0) {
    reportWarning(
      `Ignoring Mastodon-only options on ${source.platform}: ${usedMastodonOnly.join(", ")}`,
      source.url,
      onError,
    );
  }
}
if (sources.length === 0) {
  reportError(new Error("Invalid or missing feed source"), "", onError);
}

const feedOptions = {
  timeoutMs: timeout,
  cacheTtlMs: cacheTtl !== undefined ? cacheTtl * 1000 : undefined,
  retries,
  onError,
};
const merged = urls.length > 1;

let items: ParsedFeed["items"] = null;
let link: string | null = null;
let feeds: ParsedFeed[] = [];
if (merged) {
  const result = await parseFeeds(urls, feedOptions);
  items = result.items;
  feeds = result.feeds.filter((feed) => feed.items !== null);
} else if (urls.length === 1) {
  const feed = await parseFeed(urls[0], feedOptions);
  ({ items, link } = feed);
  feeds = feed.items ? [feed] : [];
}

const platformOf = (source?: { url: string }): Platform =>
  platformByUrl.get(source?.url ?? urls[0]) ?? "mastodon";
const filtered =
  items &&
  items
    .map((item) => {
      const itemPlatform = platformOf(item.source);
      return {
        item: normalizeEntry(item, itemPlatform),
        platform: itemPlatform,
      };
    })
    .filter(
      ({ item, platform: itemPlatform }) =>
        itemPlatform !== "mastodon" ||
        matchesFilter(item, { onlyWithMedia, tag }),
    );
const maxItems =
  limit !== undefined && !Number.isNaN(limit)
    ? Math.max(0, Math.floor(limit))
    : undefined;
const visibleItems =
  filtered && maxItems !== undefined ? filtered.slice(0, maxItems) : filtered;
---

<section class={classList.feed}>
  {header && feeds.length > 0 && (
    <FeedHeader feeds={feeds} classList={classList} />
  )}
  {!visibleItems ? (
    <ErrorLoadingFeed label={l.errorLoadingFeed} classList={classList} />
  ) : visibleItems.length === 0 ? (
    <NoItemsInFeed label={l.noItemsInFeed} classList={classList} />
  ) : (
    <ul class={classList.feed__list}>
      {visibleItems.map(({ item, platform: itemPlatform }) => (
        <li class={classList.feed__item}>
          <FeedItem
            link={item.link}
            pubDate={item.pubDate}
            content={item.content}
            title={item.title}
            thumbnail={media ? item.thumbnail : undefined}
            embed={media && embed ? item.embed : undefined}
            platform={itemPlatform}
            labels={l}
            media={media ? item.media : []}
            tags={tags ? item.tags : []}
            instanceUrl={item.source?.link ?? link}
            author={merged ? item.source : undefined}
            locale={locale}
            timeZone={timeZone}
            sanitize={sanitize}
            classList={classList}
          />
          {showSeparator && <hr class={classList.separator} />}
        </li>
      ))}
    </ul>
  )}
  {link && (
    <a
      class={classList.see_more}
      href={link}
      target="_blank"
      rel="noopener noreferrer"
    >
      {l.seeMore}
    </a>
  )}
</section>
