---
import FeedItem from "./components/FeedItem.astro";
import ErrorLoadingFeed from "./components/ErrorLoadingFeed.astro";
import NoItemsInFeed from "./components/NoItemsInFeed.astro";
import { parseFeed } from "./lib/parseFeed";
import type { ClassList } from "./types";

interface Props {
  url: string;
  classList?: ClassList;
  limit?: number;
  separator?: boolean;
  /** @deprecated Misspelled, use `separator` instead. */
  seperator?: boolean;
  /** Render attached images, videos and audio. Defaults to `true`. */
  media?: boolean;
  /** Render a hashtag list for each post. Defaults to `false`. */
  tags?: boolean;
}

const {
  url,
  classList = {},
  limit,
  separator,
  seperator,
  media = true,
  tags = false,
}: Props = Astro.props;
const showSeparator = separator ?? seperator ?? false;

const { items, link } = await parseFeed(url);
const maxItems =
  limit !== undefined && !Number.isNaN(limit)
    ? Math.max(0, Math.floor(limit))
    : undefined;
const visibleItems =
  items && maxItems !== undefined ? items.slice(0, maxItems) : items;
---

<section>
  {!visibleItems ? (
    <ErrorLoadingFeed classList={classList} />
  ) : visibleItems.length === 0 ? (
    <NoItemsInFeed classList={classList} />
  ) : (
    visibleItems.map((item) => (
      <div>
        <FeedItem
          link={item.link}
          pubDate={item.pubDate}
          content={item.content}
          media={media ? item.media : []}
          tags={tags ? item.tags : []}
          instanceUrl={link}
          classList={classList}
        />
        {showSeparator && <hr class={classList.separator} />}
      </div>
    ))
  )}
  {link && (
    <a
      class={classList.see_more}
      href={link}
      target="_blank"
      rel="noopener noreferrer"
    >
      See more
    </a>
  )}
</section>
