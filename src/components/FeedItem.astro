---
import FeedMedia from "./FeedMedia.astro";
import { formatDate } from "../lib/formatDate";
import { sanitizeContent } from "../lib/sanitize";
import { tagUrl, viewLabels, type Platform } from "../lib/platforms";
import type {
  ClassList,
  FeedMedia as FeedMediaType,
  FeedSource,
  Labels,
} from "../types";

interface Props {
  pubDate: string;
  content: string;
  link: string;
  /** Post title, e.g. a PeerTube video title. */
  title?: string;
  /** Preview image linking to the post, e.g. a PeerTube video thumbnail. */
  thumbnail?: string;
  platform?: Platform;
  labels: Required<Labels>;
  media?: FeedMediaType[];
  tags?: string[];
  instanceUrl?: string | null;
  locale?: string;
  timeZone?: string;
  sanitize?: boolean;
  /** The account the post came from; shown above the post when merging feeds. */
  author?: FeedSource;
  classList?: ClassList;
}

const {
  pubDate,
  content,
  link,
  title,
  thumbnail,
  platform = "mastodon",
  labels,
  media = [],
  tags = [],
  instanceUrl,
  locale,
  timeZone,
  sanitize = true,
  author,
  classList,
} = Astro.props;

const tagHref = (tag: string) => tagUrl(platform, tag, instanceUrl ?? link);
const viewLabel = labels[viewLabels[platform]];

const date = new Date(pubDate);
const hasDate = !Number.isNaN(date.getTime());
const dateString = hasDate ? formatDate(date, { locale, timeZone }) : "";
---

<article class={classList?.toot}>
  {author && (author.title || author.image) && (
    <div class={classList?.toot__author}>
      {author.image && (
        <img
          class={classList?.toot__author__avatar}
          src={author.image}
          alt=""
          loading="lazy"
        />
      )}
      {author.title &&
        (author.link ? (
          <a
            class={classList?.toot__author__name}
            href={author.link}
            target="_blank"
            rel="noopener noreferrer"
          >
            {author.title}
          </a>
        ) : (
          <span class={classList?.toot__author__name}>{author.title}</span>
        ))}
    </div>
  )}
  {hasDate && (
    <header class={classList?.toot__header}>
      <div class={classList?.toot__header__date}>
        <time datetime={date.toISOString()}>{dateString}</time>
      </div>
    </header>
  )}
  {title && (
    <div class={classList?.toot__title}>
      {link ? (
        <a href={link} target="_blank" rel="noopener noreferrer">
          {title}
        </a>
      ) : (
        title
      )}
    </div>
  )}
  {thumbnail &&
    (link ? (
      <a href={link} target="_blank" rel="noopener noreferrer">
        <img
          class={classList?.toot__thumbnail}
          src={thumbnail}
          alt={title ?? viewLabel}
          loading="lazy"
        />
      </a>
    ) : (
      <img
        class={classList?.toot__thumbnail}
        src={thumbnail}
        alt={title ?? ""}
        loading="lazy"
      />
    ))}
  <div
    class={classList?.toot__content}
    set:html={sanitize ? sanitizeContent(content) : content}
  />
  {media.length > 0 && (
    <FeedMedia
      media={media}
      sensitiveLabel={labels.sensitiveContent}
      classList={classList}
    />
  )}
  {tags.length > 0 && (
    <ul class={classList?.toot__tags}>
      {tags.map((tag) => (
        <li class={classList?.toot__tag}>
          <a href={tagHref(tag)} target="_blank" rel="noopener noreferrer">
            #{tag}
          </a>
        </li>
      ))}
    </ul>
  )}
  {link && (
    <footer class={classList?.toot__footer}>
      <a
        class={classList?.toot__footer__link}
        href={link}
        target="_blank"
        rel="noopener noreferrer"
      >
        {viewLabel}
      </a>
    </footer>
  )}
</article>
