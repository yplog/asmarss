---
import FeedMedia from "./FeedMedia.astro";
import { formatDate } from "../lib/formatDate";
import type { ClassList, FeedMedia as FeedMediaType, Labels } from "../types";

interface Props {
  pubDate: string;
  content: string;
  link: string;
  labels: Required<Labels>;
  media?: FeedMediaType[];
  tags?: string[];
  instanceUrl?: string | null;
  locale?: string;
  timeZone?: string;
  classList?: ClassList;
}

const {
  pubDate,
  content,
  link,
  labels,
  media = [],
  tags = [],
  instanceUrl,
  locale,
  timeZone,
  classList,
} = Astro.props;

function tagHref(tag: string) {
  try {
    return new URL(`/tags/${encodeURIComponent(tag)}`, instanceUrl ?? link)
      .href;
  } catch {
    return undefined;
  }
}

const date = new Date(pubDate);
const hasDate = !Number.isNaN(date.getTime());
const dateString = hasDate ? formatDate(date, { locale, timeZone }) : "";
---

<article class={classList?.toot}>
  {hasDate && (
    <header class={classList?.toot__header}>
      <div class={classList?.toot__header__date}>
        <time datetime={date.toISOString()}>{dateString}</time>
      </div>
    </header>
  )}
  <div class={classList?.toot__content} set:html={content} />
  {media.length > 0 && (
    <FeedMedia
      media={media}
      sensitiveLabel={labels.sensitiveContent}
      classList={classList}
    />
  )}
  {tags.length > 0 && (
    <ul class={classList?.toot__tags}>
      {tags.map((tag) => (
        <li class={classList?.toot__tag}>
          <a href={tagHref(tag)} target="_blank" rel="noopener noreferrer">
            #{tag}
          </a>
        </li>
      ))}
    </ul>
  )}
  {link && (
    <footer class={classList?.toot__footer}>
      <a
        class={classList?.toot__footer__link}
        href={link}
        target="_blank"
        rel="noopener noreferrer"
      >
        {labels.viewOnMastodon}
      </a>
    </footer>
  )}
</article>
