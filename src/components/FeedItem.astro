---
import FeedMedia from "./FeedMedia.astro";
import type { ClassList, FeedMedia as FeedMediaType } from "../types";

interface Props {
  pubDate: string;
  content: string;
  link: string;
  media?: FeedMediaType[];
  tags?: string[];
  instanceUrl?: string | null;
  classList?: ClassList;
}

const {
  pubDate,
  content,
  link,
  media = [],
  tags = [],
  instanceUrl,
  classList,
} = Astro.props;

function tagHref(tag: string) {
  try {
    return new URL(`/tags/${encodeURIComponent(tag)}`, instanceUrl ?? link)
      .href;
  } catch {
    return undefined;
  }
}

const date = new Date(pubDate);
const hasDate = !Number.isNaN(date.getTime());
const dateString = date.toDateString();
const timeString = date.toLocaleTimeString([], {
  hour: "2-digit",
  minute: "2-digit",
});
---

<div class={classList?.toot}>
  {hasDate && (
    <div class={classList?.toot__header}>
      <div class={classList?.toot__header__date}>
        <p>
          <time datetime={date.toISOString()}>
            {dateString} at {timeString}
          </time>
        </p>
      </div>
    </div>
  )}
  <div>
    <div class={classList?.toot__content} set:html={content} />
  </div>
  {media.length > 0 && <FeedMedia media={media} classList={classList} />}
  {tags.length > 0 && (
    <ul class={classList?.toot__tags}>
      {tags.map((tag) => (
        <li class={classList?.toot__tag}>
          <a href={tagHref(tag)} target="_blank" rel="noopener noreferrer">
            #{tag}
          </a>
        </li>
      ))}
    </ul>
  )}
  <div class={classList?.toot__footer}>
    <a
      class={classList?.toot__footer__link}
      href={link}
      target="_blank"
      rel="noopener noreferrer"
    >
      View on Mastodon
    </a>
  </div>
</div>
