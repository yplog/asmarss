---
import ExternalLink from "./ExternalLink.astro";
import FeedMedia from "./FeedMedia.astro";
import FeedPreview from "./FeedPreview.astro";
import { formatDate } from "../lib/formatDate";
import { sanitizeContent } from "../lib/sanitize";
import { tagUrl, viewLabels, type Platform } from "../lib/platforms";
import type {
  ClassList,
  FeedMedia as FeedMediaType,
  FeedSource,
  Labels,
} from "../types";

interface Props {
  pubDate: string;
  content: string;
  link: string;
  /** Post title, e.g. a PeerTube video title. */
  title?: string;
  /** Preview image linking to the post, e.g. a PeerTube video thumbnail. */
  thumbnail?: string;
  /** Player URL; replaces the thumbnail with an iframe when it is on the post's origin. */
  embed?: string;
  platform?: Platform;
  labels: Required<Labels>;
  media?: FeedMediaType[];
  tags?: string[];
  instanceUrl?: string | null;
  locale?: string;
  timeZone?: string;
  sanitize?: boolean;
  /** The account the post came from; shown above the post when merging feeds. */
  author?: FeedSource;
  classList?: ClassList;
}

const {
  pubDate,
  content,
  link,
  title,
  thumbnail,
  embed,
  platform = "mastodon",
  labels,
  media = [],
  tags = [],
  instanceUrl,
  locale,
  timeZone,
  sanitize = true,
  author,
  classList = {},
} = Astro.props;

const tagHref = (tag: string) => tagUrl(platform, tag, instanceUrl ?? link);
const viewLabel = labels[viewLabels[platform]];

const date = new Date(pubDate);
const hasDate = !Number.isNaN(date.getTime());
const dateString = hasDate ? formatDate(date, { locale, timeZone }) : "";
---

<article class={classList.post}>
  {author && (author.title || author.image) && (
    <div class={classList.post__author}>
      {author.image && (
        <img
          class={classList.post__author__avatar}
          src={author.image}
          alt=""
          loading="lazy"
        />
      )}
      {author.title && (
        <ExternalLink class={classList.post__author__name} href={author.link}>
          {author.title}
        </ExternalLink>
      )}
    </div>
  )}
  {hasDate && (
    <header class={classList.post__header}>
      <div class={classList.post__header__date}>
        <time datetime={date.toISOString()}>{dateString}</time>
      </div>
    </header>
  )}
  {title && (
    <div class={classList.post__title}>
      {link ? <ExternalLink href={link}>{title}</ExternalLink> : title}
    </div>
  )}
  <FeedPreview
    link={link}
    title={title}
    thumbnail={thumbnail}
    embed={embed}
    label={viewLabel}
    classList={classList}
  />
  <div
    class={classList.post__content}
    set:html={sanitize ? sanitizeContent(content) : content}
  />
  {media.length > 0 && (
    <FeedMedia
      media={media}
      sensitiveLabel={labels.sensitiveContent}
      classList={classList}
    />
  )}
  {tags.length > 0 && (
    <ul class={classList.post__tags}>
      {tags.map((tag) => (
        <li class={classList.post__tag}>
          <ExternalLink href={tagHref(tag)}>#{tag}</ExternalLink>
        </li>
      ))}
    </ul>
  )}
  {link && (
    <footer class={classList.post__footer}>
      <ExternalLink class={classList.post__footer__link} href={link}>
        {viewLabel}
      </ExternalLink>
    </footer>
  )}
</article>
