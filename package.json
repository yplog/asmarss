{
  "name": "asmarss",
  "version": "0.6.0",
  "description": "A package that enables tracking the most recent posts of a Mastodon account and rendering them as an RSS feed.",
  "author": {
    "name": "Yalın Pala",
    "url": "https://yalinpala.dev"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yplog/asmarss.git"
  },
  "keywords": [
    "astro",
    "mastodon",
    "astro-component",
    "rss"
  ],
  "main": "src/index.astro",
  "exports": {
    ".": "./src/index.astro",
    "./types": "./src/types.ts",
    "./feed": "./src/feed.ts"
  },
  "files": [
    "src"
  ],
  "type": "module",
  "scripts": {
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "astro check"
  },
  "peerDependencies": {
    "astro": ">=4"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@types/node": "^26.6.4",
    "@types/sanitize-html": "^2.16.2",
    "@vitest/coverage-v8": "^5.0.4",
    "astro": "^7.1.0",
    "prettier": "^3.9.9",
    "prettier-plugin-astro": "^1.1.0",
    "typescript": "^6.0.3",
    "vitest": "^5.0.3"
  },
  "dependencies": {
    "fast-xml-parser": "^5.11.2",
    "sanitize-html": "^2.18.0"
  },
  "engines": {
    "node": ">=22"
  }
}
